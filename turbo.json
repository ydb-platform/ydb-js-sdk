{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"codegen": {
			"dependsOn": ["^codegen"],
			"outputs": ["./src/gen/**"]
		},
		"clean": {
			"inputs": ["./dist/**"],
			"outputs": []
		},
		"build": {
			"dependsOn": ["^build", "clean", "codegen"],
			"inputs": ["./src/**"],
			"outputs": ["./dist/**", "./.vitepress/dist/**"]
		},
		"test": {
			"dependsOn": ["^test", "build"],
			"outputs": []
		}
	}
}
