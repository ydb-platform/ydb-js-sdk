{
	"name": "ydbjs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"e2e/*",
		"tests/*",
		"packages/*",
		"third-parties/*"
	],
	"engines": {
		"node": "^22.15.0 || ^24.0.0 || >=26.0.0",
		"npm": ">=10"
	},
	"engineStrict": true,
	"scripts": {
		"build": "npx --yes turbo@2.11.10 run build --output-logs=errors-only",
		"attw": "npx --yes -w packages -w third-parties @arethetypeswrong/cli@0.18.5 --pack --profile esm-only",
		"test": "vitest --run",
		"test:grpc": "vitest --run --config vitest.grpc.config.ts",
		"bench": "vitest bench --run --maxWorkers=1",
		"coverage": "vitest --run --coverage",
		"lint": "oxlint --fix",
		"format": "oxfmt --write",
		"version": "npx --yes -p @changesets/cli@3.0.3 -p @changesets/changelog-github@1.0.1 changeset version && npm install",
		"publish": "npx --yes @changesets/cli@3.0.3 publish",
		"prepare": "git config core.hooksPath scripts/hooks"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"zx": "^8.8.5"
	},
	"packageManager": "npm@11.21.1"
}
