{
	"name": "ydbjs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"docs",
		"e2e/*",
		"tests/*",
		"examples/*",
		"packages/*",
		"third-parties/*"
	],
	"engines": {
		"node": "^22.15.0 || ^24.0.0 || >=26.0.0",
		"npm": ">=10.9.0"
	},
	"engineStrict": true,
	"scripts": {
		"build": "turbo run build --output-logs=errors-only",
		"attw": "turbo run attw",
		"test": "vitest --run",
		"test:grpc": "vitest --run --config vitest.grpc.config.ts",
		"bench": "vitest bench --run --maxWorkers=1",
		"coverage": "vitest --run --coverage",
		"lint": "oxlint --fix",
		"format": "oxfmt --write",
		"version": "changeset version && npm install",
		"publish": "changeset publish",
		"prepare": "git config core.hooksPath scripts/hooks"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"@vitest/ui": "^5.0.5",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"turbo": "^2.11.10",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"zx": "^8.8.5"
	},
	"packageManager": "npm@11.21.1"
}
