{
	"name": "@ydbjs/value",
	"version": "6.0.8",
	"description": "Type-safe conversion and manipulation of YDB values and types. Encode/decode between native JS and YDB, with full support for primitives and complex types.",
	"keywords": [
		"conversion",
		"database",
		"types",
		"typescript",
		"value",
		"ydb"
	],
	"homepage": "https://github.com/ydb-platform/ydb-js-sdk#readme",
	"bugs": {
		"url": "https://github.com/ydb-platform/ydb-js-sdk/issues"
	},
	"license": "Apache-2.0",
	"author": "YDB Team <team@ydb.tech> (https://ydb.tech)",
	"contributors": [
		"Vladislav Polyakov <me@polrk.com>"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ydb-platform/ydb-js-sdk.git",
		"directory": "packages/value"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"ydbjs-source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./primitive": {
			"ydbjs-source": "./src/primitive.ts",
			"default": "./dist/primitive.js"
		},
		"./optional": {
			"ydbjs-source": "./src/optional.ts",
			"default": "./dist/optional.js"
		},
		"./struct": {
			"ydbjs-source": "./src/struct.ts",
			"default": "./dist/struct.js"
		},
		"./dict": {
			"ydbjs-source": "./src/dict.ts",
			"default": "./dist/dict.js"
		},
		"./tuple": {
			"ydbjs-source": "./src/tuple.ts",
			"default": "./dist/tuple.js"
		},
		"./list": {
			"ydbjs-source": "./src/list.ts",
			"default": "./dist/list.js"
		},
		"./null": {
			"ydbjs-source": "./src/null.ts",
			"default": "./dist/null.js"
		},
		"./uuid": {
			"ydbjs-source": "./src/uuid.ts",
			"default": "./dist/uuid.js"
		},
		"./print": {
			"ydbjs-source": "./src/print.ts",
			"default": "./dist/print.js"
		},
		"./decimal": {
			"ydbjs-source": "./src/decimal.ts",
			"default": "./dist/decimal.js"
		},
		"./empty": {
			"ydbjs-source": "./src/empty.ts",
			"default": "./dist/empty.js"
		},
		"./tagged": {
			"ydbjs-source": "./src/tagged.ts",
			"default": "./dist/tagged.js"
		},
		"./vector": {
			"ydbjs-source": "./src/vector.ts",
			"default": "./dist/vector.js"
		},
		"./void": {
			"ydbjs-source": "./src/void.ts",
			"default": "./dist/void.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc",
		"test": "vitest --run"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.16.0",
		"@ydbjs/api": "^6.0.7"
	},
	"engines": {
		"node": "^22.23.5 || ^24.22.3 || >=26.13.1",
		"npm": ">=10"
	},
	"engineStrict": true,
	"devDependencies": {
		"temporal-polyfill": "1.0.6"
	}
}
