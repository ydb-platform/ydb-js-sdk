{
	"name": "@ydbjs/slo",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsc --noEmit && bun run ./scripts/build.ts",
		"start:kv": "node --env-file=.env ./dist/index.js --setup=kv.setup --kv.setup.prefill=1000 --teardown=kv.teardown --worker=kv.read --kv.read.rps=1000 --kv.read.keyspace=1000 --worker=kv.write --kv.write.rps=100 --kv.write.keyspace=1000",
		"start:topic": "node --env-file=.env ./dist/index.js --setup=topic.setup --worker=topic.write --worker=topic.read --teardown=topic.teardown --topic.setup.partitions=10 --topic.write.rps=100 --topic.write.size=1024 --topic.write.codec=mixed"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.16.0",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
		"@opentelemetry/sdk-metrics": "^2.7.1",
		"@ydbjs/abortable": "*",
		"@ydbjs/api": "*",
		"@ydbjs/auth": "*",
		"@ydbjs/core": "*",
		"@ydbjs/grpc": "*",
		"@ydbjs/query": "*",
		"@ydbjs/topic": "*",
		"@ydbjs/value": "*",
		"hdr-histogram-js": "3.0.1"
	},
	"publishConfig": {
		"access": "restricted"
	}
}
